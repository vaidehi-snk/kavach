# Copy this file to .env and fill in what you use. .env is git-ignored.

# Push alerts to the family's phone with the free ntfy app (https://ntfy.sh).
# Anyone who knows the topic name can read it, so keep it long and random.
KAVACH_NTFY_TOPIC=

# Amazon Bedrock (off unless set to "bedrock"). Optional: Kavach runs fully offline without it.
KAVACH_LLM=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KAVACH_SPEND_CAP_INR=50
